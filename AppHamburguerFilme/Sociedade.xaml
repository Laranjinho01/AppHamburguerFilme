<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHamburguerFilme.Sociedade"
             BackgroundColor="#121212">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            Margin="0,0,0,40">

        <Label
            Text="Sociedade dos Poetas Mortos"
            FontSize="40"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center"
            Margin="0,30,0,0"
            TextColor="White" 
            FontFamily="Hiddencinema"/>

        <Image Source="sociedade.jpg"
            HorizontalOptions="Center"
            HeightRequest="300"/>

        <Label
            Text="Em um internato de elite e estilo tradicional na Nova Inglaterra, um professor de inglês apaixonado inspira seus alunos a se rebelarem contra as convenções e a aproveitarem o potencial de cada dia, despertando o desprezo do diretor rigoroso."
            FontSize="18"
            HorizontalTextAlignment="Justify"
            HorizontalOptions="Center"
            TextColor="White"
            FontFamily="dayrom"/>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>