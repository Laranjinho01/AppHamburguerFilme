<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHamburguerFilme.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

        <Label
            Text="Meus Filmes Favoritos"
            FontSize="40"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,30,0,0"
            TextColor="White" 
            FontFamily="Hiddencinema"/>

        <Image Source="absolute_cinema.webp"
            HorizontalOptions="Center"
            HeightRequest="200"/>

        <Label
            Text="Seja bem-vindo(a)!"
            FontSize="30"
            HorizontalOptions="Center"
            TextColor="White"
            FontFamily="Hiddencinema"
            Margin="0,10,0,0"/>

            <Label
            Text="Abra o menu lateral (gaveta) no canto superior esquerdo"
            FontSize="20"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,10,0,0"
            TextColor="LightGrey"
            FontFamily="Hiddencinema"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
